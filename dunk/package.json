{
  "name": "json-maclane",
  "productName": "Dunk",
  "version": "1.3.0",
  "description": "Tray helper: receives Figma frames from the Alleyoop Figma plugin and builds layered .ai files in Adobe Illustrator.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "cli": "node src/server-cli.js",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "hu.tibu.jsonmaclane",
    "productName": "Dunk",
    "files": [
      "main.js",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "!src/build-ai.jsx"
    ],
    "extraResources": [
      { "from": "src/build-ai.jsx", "to": "build-ai.jsx" }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "A Dunk az Adobe Illustratort vezérli, hogy a Figma-keretekből rétegezett .ai fájlokat építsen."
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dunk",
      "artifactName": "Dunk-${version}-win-x64-setup.${ext}"
    }
  }
}
